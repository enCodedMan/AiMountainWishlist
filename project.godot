; Engine configuration file.
config_version=5

[application]
config/name="Kingjump"
config/description="A checkers roguelike: chain jumps, stack passive cards, beat the bot."
config/version="0.1.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.0745, 0.0706, 0.1098, 1)
boot_splash/show_image=false

[display]
window/size/viewport_width=480
window/size/viewport_height=860
window/size/window_width_override=540
window/size/window_height_override=968
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.0745, 0.0706, 0.1098, 1)
